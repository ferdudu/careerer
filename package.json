{
  "name": "careerer",
  "version": "0.1.0",
  "description": "Careerer: tailored resumes and cover letters from a job posting and your profile",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Careerer",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis",
    "mock-export": "node scripts/mock-export.mjs",
    "smoke": "node scripts/smoke.mjs",
    "real-check": "node scripts/real-check.mjs"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
